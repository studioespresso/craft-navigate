{# v-pre: cp/Screen compiles this as a Vue template; the tree is managed by structure.js #}
<div class="cp-container" v-pre>
    <div class="navigate-structure"
         data-nav-id="{{ navigation.id }}"
         data-site-id="{{ site.id }}"
         data-levels="{{ navigation.levels }}"
         data-element-types="{{ elementTypes|json_encode }}"
         data-confirm-delete="{{ 'Are you sure you want to delete “{name}” and its descendants?'|t('navigate') }}">
        <div class="navigate-structure__add" role="group" aria-label="{{ 'Add an item'|t('navigate') }}">
            {% for nodeType in nodeTypes %}
                <craft-button icon="plus" data-add="{{ nodeType.handle }}">{{ nodeType.title|t('navigate') }}</craft-button>
            {% endfor %}
        </div>
        <div class="navigate-structure__tree" data-tree aria-live="polite">
            {{ tree|raw }}
        </div>
    </div>
</div>
